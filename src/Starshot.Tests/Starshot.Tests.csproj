<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Integration test project (xunit.v3 + Microsoft.Testing.Platform). Every test here drives
      the real HDR recording pipeline end to end (C++ signal host, the record-test host in
      Starshot, and ffmpeg) against a physical HDR display, so each one self-skips when a
      prerequisite is missing; a plain dotnet test is always safe. See the "Integration
      tests" section of the top-level README.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- VSTest bridge so `dotnet test` runs the suite (the metapackage's MTP runner also
         works by running the built exe directly). Versions match the local NuGet cache, so
         the restore works offline. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
