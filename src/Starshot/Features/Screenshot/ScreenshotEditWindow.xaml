<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx
  x:Class="Starshot.Features.Screenshot.ScreenshotEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sf="using:Starshot.Frameworks"
  Title="Screenshot Editor"
  x:DefaultBindMode="OneWay"
  mc:Ignorable="d"
>
  <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  工具栏：按钮 + 内联工具选项（模糊强度 / 颜色与粗细），占一行不压缩图像  -->
    <StackPanel
      Grid.Row="0"
      Padding="8,6"
      Orientation="Horizontal"
      Spacing="6"
    >
      <ToggleButton
        x:Name="ToggleButton_Blur"
        Click="ToolButton_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Blur}"
      >
        <!--  模糊：软边方（中心较实、边缘淡出 = “模糊”隐喻；中性灰在深浅两种主题下均可读）  -->
        <Path Width="16" Height="16">
          <Path.Data>M5.5,2 L10.5,2 L14,5.5 L14,10.5 L10.5,14 L5.5,14 L2,10.5 L2,5.5 Z</Path.Data>
          <Path.Fill>
            <RadialGradientBrush
              Center="0.5,0.5"
              GradientOrigin="0.5,0.5"
              RadiusX="0.8"
              RadiusY="0.8"
            >
              <GradientStop Color="#F0808080" Offset="0" />
              <GradientStop Color="#99808080" Offset="0.7" />
              <GradientStop Color="#00808080" Offset="1" />
            </RadialGradientBrush>
          </Path.Fill>
        </Path>
      </ToggleButton>
      <ToggleButton
        x:Name="ToggleButton_Highlight"
        Click="ToolButton_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Highlight}"
      >
        <!--  高亮：斜置马克笔（笔杆 + 斜切笔头）+ 下方一道高光笔触  -->
        <Grid Width="16" Height="16">
          <Path
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="1.5"
            StrokeLineJoin="Round"
            Data="M12.1,2.1 L13.9,3.9 L8.9,8.9 L6.6,11.6 L4.4,9.4 L7.1,7.1 Z M7.1,7.1 L8.9,8.9" />
          <Path
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="2"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Data="M3.2,13 L7.2,13" />
        </Grid>
      </ToggleButton>
      <ToggleButton
        x:Name="ToggleButton_Brush"
        Click="ToolButton_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Brush}"
      >
        <FontIcon FontSize="16" Glyph="&#xE70F;" />
      </ToggleButton>
      <ToggleButton
        x:Name="ToggleButton_Erase"
        Click="ToolButton_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Erase}"
      >
        <!--  擦除：斜置橡皮（下端灰色为擦头，分界线下为擦头区）  -->
        <Grid Width="16" Height="16">
          <Path
            Fill="{ThemeResource TextFillColorSecondaryBrush}"
            Data="M2.6,10 L5.1,7.5 L8.5,10.9 L6,13.4 Z" />
          <Path
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="1.5"
            StrokeLineJoin="Round"
            Data="M2.6,10 L10,2.6 L13.4,6 L6,13.4 Z M5.1,7.5 L8.5,10.9" />
        </Grid>
      </ToggleButton>
      <ToggleButton
        x:Name="ToggleButton_Select"
        Click="ToolButton_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Select}"
      >
        <!--  选择：经典指针箭头（实心 + 细描边圆角）  -->
        <Path
          Width="16"
          Height="16"
          Fill="{ThemeResource TextFillColorPrimaryBrush}"
          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
          StrokeThickness="1"
          StrokeLineJoin="Round"
          Data="M2.4,2.5 L7,14 L8.4,9.4 L13,8 Z" />
      </ToggleButton>

      <Button
        x:Name="Button_Undo"
        Click="Button_Undo_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Undo}"
      >
        <FontIcon FontSize="16" Glyph="&#xE7A7;" />
      </Button>
      <Button
        x:Name="Button_Clear"
        Click="Button_Clear_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Clear}"
      >
        <FontIcon FontSize="16" Glyph="&#xE74D;" />
      </Button>
      <Button
        x:Name="Button_Save"
        Click="Button_Save_Click"
        Margin="2,0"
        Padding="8,4"
        Style="{ThemeResource AccentButtonStyle}"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Save}"
      >
        <FontIcon FontSize="16" Glyph="&#xE74E;" />
      </Button>
      <Button
        x:Name="Button_Close"
        Click="Button_Close_Click"
        Margin="2,0"
        Padding="8,4"
        ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Close}"
      >
        <FontIcon FontSize="16" Glyph="&#xE8BB;" />
      </Button>

      <Border
        Width="1"
        Margin="4,2"
        Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

      <!--  模糊选项：区域模糊强度  -->
      <StackPanel
        x:Name="Panel_Strength"
        Orientation="Horizontal"
        Spacing="6"
        Visibility="Collapsed"
      >
        <TextBlock
          VerticalAlignment="Center"
          Text="{x:Bind lang:Lang.ScreenshotEditWindow_Strength}" />
        <Slider
          x:Name="Slider_Strength"
          Width="110"
          Maximum="50"
          Minimum="2"
          Value="14" />
      </StackPanel>

      <!--  高亮/画笔选项：颜色（ColorBox 弹层选色，不内联展开）与粗细  -->
      <StackPanel
        x:Name="Panel_ColorOptions"
        Orientation="Horizontal"
        Spacing="6"
        Visibility="Collapsed"
      >
        <TextBlock
          VerticalAlignment="Center"
          Text="{x:Bind lang:Lang.ScreenshotEditWindow_Color}" />
        <!--  色块按钮：点开弹层选色（ColorPicker 放弹层里，避免内联展开压缩工具栏）  -->
        <Button
          x:Name="Button_ColorSwatch"
          Width="36"
          Height="28"
          Padding="0"
        >
          <Button.Flyout>
            <Flyout x:Name="Flyout_Color">
              <ColorPicker
                x:Name="ColorPicker_Color"
                IsAlphaEnabled="False" />
            </Flyout>
          </Button.Flyout>
          <Rectangle
            x:Name="ColorSwatch_Fill"
            Width="28"
            Height="20"
            RadiusX="2"
            RadiusY="2"
            Fill="Red" />
        </Button>
        <TextBlock
          Margin="6,0,0,0"
          VerticalAlignment="Center"
          Text="{x:Bind lang:Lang.ScreenshotEditWindow_Size}" />
        <Slider
          x:Name="Slider_Thickness"
          Width="110"
          Maximum="48"
          Minimum="2"
          Value="8" />
      </StackPanel>

      <!--  选择工具选项：删除当前选中的元素  -->
      <StackPanel
        x:Name="Panel_Delete"
        Orientation="Horizontal"
        Spacing="6"
        Visibility="Collapsed"
      >
        <Button
          x:Name="Button_Delete"
          Click="Button_Delete_Click"
          IsEnabled="False"
          Margin="2,0"
          Padding="8,4"
          ToolTipService.ToolTip="{x:Bind lang:Lang.ScreenshotEditWindow_Delete}"
        >
          <FontIcon FontSize="16" Glyph="&#xE74D;" />
        </Button>
      </StackPanel>
    </StackPanel>

    <!--  图像区  -->
    <Grid Grid.Row="1" Background="{ThemeResource SmokeFillColorDefaultBrush}">
      <Image
        x:Name="Image_Image"
        Margin="16"
        Stretch="Uniform"
      />
    </Grid>

    <!--  状态行  -->
    <TextBlock
      x:Name="TextBlock_Status"
      Grid.Row="2"
      Margin="12,6"
      FontSize="12"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Text="{x:Bind lang:Lang.ScreenshotEditWindow_SavedTo}"
      TextTrimming="CharacterEllipsis"
    />
  </Grid>
</sf:WindowEx>
